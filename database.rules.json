{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Manager')"
      }
    },
    "data": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || $uid === 'vaziamts')",
        ".write": "auth != null && (auth.uid === $uid || $uid === 'vaziamts')"
      }
    },
    "public": {
      "packages": {
        ".read": true,
        "$id": {
          ".write": "auth != null"
        }
      },
      "leads": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || $uid === 'vaziamts')",
          ".write": true
        }
      },
      "approvals": {
        "$uid": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Manager')",
          "$req": {
            ".read": true,
            ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Manager')) || newData.child('status').val() === 'pending'"
          }
        }
      },
      "dl_tokens": {
        "$token": {
          ".read": false,
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Manager')"
        }
      },
      "hub": {
        "$slug": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "gallery": {
        "$id": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "hits": {
        ".read": "auth != null",
        "$kind": {
          ".read": "auth != null",
          ".write": true
        }
      }
    },
    "distribution": {
      "vaziamts": {
        ".read": "auth != null",
        "sending_domains": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin')"
        },
        "team_email_settings": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin')"
        },
        "suppressions": {
          ".write": false
        },
        "email_sends": {
          ".write": false,
          ".indexOn": ["created_at"]
        },
        "email_events": {
          ".write": false,
          ".indexOn": ["created_at"]
        },
        "jobs": {
          ".write": false,
          ".indexOn": ["due_at"]
        },
        "alerts": {
          ".write": false
        },
        "campaigns": {
          ".write": "auth != null",
          ".indexOn": ["created_at"]
        },
        "templates": {
          ".write": "auth != null",
          ".indexOn": ["created_at"]
        }
      }
    }
  }
}
