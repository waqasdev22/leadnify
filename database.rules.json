{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'Owner' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Manager')"
      }
    },
    "data": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || $uid === 'vaziamts')",
        ".write": "auth != null && (auth.uid === $uid || $uid === 'vaziamts')"
      }
    },
    "public": {
      "packages": {
        ".read": true,
        "$id": {
          ".write": "auth != null"
        }
      },
      "leads": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || $uid === 'vaziamts')",
          ".write": true
        }
      },
      "hub": {
        "$slug": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "gallery": {
        "$id": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "hits": {
        ".read": "auth != null",
        "$kind": {
          ".read": "auth != null",
          ".write": true
        }
      }
    }
  }
}
