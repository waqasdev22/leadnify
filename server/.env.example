# Paste your MongoDB connection string here (from MongoDB Atlas or a local server)
# Atlas example:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/crebuilder?retryWrites=true&w=majority
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/crebuilder
PORT=4000

# Email sending (Gmail App Password)
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
