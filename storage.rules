rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded document media: anyone can view (needed for public microsites &
    // shared documents), only signed-in users can upload.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 160 * 1024 * 1024;
    }
  }
}
